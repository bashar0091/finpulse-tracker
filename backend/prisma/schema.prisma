// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User Model for Authentication & Identity Management
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

// Transaction Model for Financial Incomes and Expenses Tracking
model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // Allowed values via logic: "INCOME" or "EXPENSE"
  amount      Float
  category    String
  description String?
  date        DateTime @default(now())
}